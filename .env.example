# URL da página inicial do seu ambiente Coupa
COUPA_URL=https://sua-empresa.coupahost.com/user/home

# Requisições com valor ABAIXO deste limite são aprovadas
LIMITE_VALOR=10000

# Texto buscado no campo "Solicitado por" (ex.: usuário de integração que cria as requisições)
FILTRO_SOLICITANTE=

# Opcional: texto buscado no campo "Nome do aprovador atual" (normalmente o seu nome)
APROVADOR=

# Pasta onde fica o perfil do navegador com a sessão salva
USER_DATA_DIR=./perfil_navegador
